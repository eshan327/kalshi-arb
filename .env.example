# auth/env
KALSHI_ENV=prod

# used when KALSHI_ENV=demo
KALSHI_DEMO_KEY_ID=demo_key_id_here
KALSHI_DEMO_KEY_PATH=.secrets/demo.txt

# used when KALSHI_ENV=prod
KALSHI_PROD_KEY_ID=prod_key_id_here
KALSHI_PROD_KEY_PATH=.secrets/prod.txt

# optional API/WS overrides
# KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# KALSHI_WS_BASE_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2

# Optional default when no CLI asset argument is supplied.
KALSHI_MARKET_ASSET=BTC

KALSHI_PAPER_STARTING_CASH_CENTS=100000
KALSHI_EXECUTION_LOOP_INTERVAL_SEC=1
KALSHI_EXECUTION_EVENTS_PATH=.runtime/execution_events.jsonl
KALSHI_EXECUTION_STATE_PATH=.runtime/trading_state.json
